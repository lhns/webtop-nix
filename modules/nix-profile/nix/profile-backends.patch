+struct ProfileSettings : Config
+{
+    /* Records whether the value came from `--profile-backend`, which conflicts with `--profile`;
+       a value from nix.conf yields to `--profile`. */
+    struct BackendSetting : Setting<std::string>
+    {
+        using Setting<std::string>::Setting;
+        bool fromCommandLine = false;
+
+        void convertToArg(Args & args, const std::string & category) override
+        {
+            args.addFlag({
+                .longName = name,
+                .description = fmt("Set the `%s` setting.", name),
+                .category = category,
+                .labels = {"value"},
+                .handler = {[this](std::string s) {
+                    overridden = true;
+                    fromCommandLine = true;
+                    set(s);
+                }},
+            });
+        }
+    };
+
+    BackendSetting backend{
+        this,
+        "profile",
+        "profile-backend",
+        R"(
+          Where `nix profile` records packages:
+
+          - `profile`: the default profile.
+          - `profile:`*path*: the profile at the absolute *path*. `--profile` *path* is short for this.
+          - `declaration:`*path*: the JSON file at the absolute *path*. `nix profile add` resolves
+            and builds flake installables and records them there (per element the fields
+            `manifest.json` has, without `storePaths` and `active`); [`profile-hook`](#conf-profile-hook)
+            then has to install what the file declares, so it is required. Store paths go to the
+            default profile; an element of the same name there moves into the file. Names and
+            store paths match elements in both; `--all` and `--regex` match the file only.
+            `nix profile list` shows both. If a change fails, the whole command is reverted.
+            `history`, `rollback` and `wipe-history` act on the file's own versions, kept as
+            generations of the profile `declaration` next to the default profile.
+        )"};
+
+    Setting<std::string> hook{
+        this,
+        "",
+        "profile-hook",
+        R"(
+          The absolute path of a program run after `nix profile` changed what is installed, in
+          either backend. If it fails, the change is reverted: a declaration file gets its previous
+          contents back, a profile its previous generation. It must exit 0 only once the change
+          is fully applied.
+
+          Its environment has `NIX_PROFILE_BACKEND` (`profile` or `declaration`), `NIX_PROFILE`
+          (the profile), `NIX_PROFILE_DECLARATION` (the declaration file, `declaration` only) and
+          `NIX_PROFILE_OPERATION` (`add`, `remove`, `upgrade` or `rollback`). A hook that runs
+          `nix profile` itself must avoid recursing, e.g. by acting only on one backend.
+        )"};
+};
+
+static ProfileSettings profileSettings;
+static GlobalConfig::Register rProfileSettings(&profileSettings);
+
+static std::optional<std::filesystem::path> profileHook()
+{
+    auto & hook = profileSettings.hook.get();
+    if (hook.empty())
+        return std::nullopt;
+    std::filesystem::path path = hook;
+    if (!path.is_absolute())
+        throw UsageError("'profile-hook = %s' must be an absolute path", hook);
+    return path;
+}
+
+static void runProfileHook(
+    std::string_view backend,
+    const std::filesystem::path & profile,
+    const std::optional<std::filesystem::path> & declaration,
+    std::string_view operation)
+{
+    auto hook = profileHook();
+    if (!hook)
+        return;
+    auto env = getEnvOs();
+    env.insert_or_assign(OS_STR("NIX_PROFILE_BACKEND"), string_to_os_string(backend));
+    env.insert_or_assign(OS_STR("NIX_PROFILE"), profile.native());
+    env.insert_or_assign(OS_STR("NIX_PROFILE_OPERATION"), string_to_os_string(operation));
+    if (declaration)
+        env.insert_or_assign(OS_STR("NIX_PROFILE_DECLARATION"), declaration->native());
+    else
+        env.erase(OS_STR("NIX_PROFILE_DECLARATION"));
+    auto suspension = logger->suspend();
+    runProgram2({.program = *hook, .lookupPath = false, .environment = std::move(env)});
+}
+
+/* Runs the hook; on failure calls `revert` and fails. */
+static void runProfileHookOrRevert(
+    std::string_view backend,
+    const std::filesystem::path & profile,
+    const std::optional<std::filesystem::path> & declaration,
+    std::string_view operation,
+    std::function<void()> revert)
+{
+    try {
+        runProfileHook(backend, profile, declaration, operation);
+    } catch (Error & e) {
+        // A revert is a commit of its own, which can fail too (a file conflict with what others committed).
+        try {
+            revert();
+        } catch (Error & revertError) {
+            throw Error(
+                "profile-hook '%s' failed and the change could not be reverted: %s; the hook's failure: %s",
+                profileSettings.hook.get(),
+                revertError.msg(),
+                e.msg());
+        }
+        throw Error("profile-hook '%s' failed, so the change was reverted: %s", profileSettings.hook.get(), e.msg());
+    }
+}
+
+/** One command's change, re-applied under the lock to the state current then. Returns whether it changed
+    anything: a remove or upgrade whose target has gone does not. */
+using Delta = std::function<bool(ProfileManifest &)>;
+
+static bool applyDeltas(const std::vector<Delta> & deltas, ProfileManifest & manifest)
+{
+    bool changed = false;
+    for (auto & delta : deltas)
+        changed |= delta(manifest);
+    return changed;
+}
+
+static bool sameElement(const ProfileElement & a, const ProfileElement & b)
+{
+    if (a.storePaths != b.storePaths || a.active != b.active || a.priority != b.priority
+        || a.source.has_value() != b.source.has_value())
+        return false;
+    return !a.source
+           || (a.source->to_string() == b.source->to_string()
+               && a.source->lockedRef.to_string() == b.source->lockedRef.to_string());
+}
+
+/* Whether adding `b` again would add nothing. */
+static bool sameFlakeOutput(const ProfileElement & a, const ProfileElement & b)
+{
+    return a.source && b.source && a.priority == b.priority && a.source->originalRef == b.source->originalRef
+           && a.source->attrPath == b.source->attrPath;
+}
+
+/* Undoes the commit from `before` to `after` on `current`, which may hold later commits of others: a name
+   goes back only if it is still what the commit made it. Returns whether `current` changed. */
+static bool undoCommit(const ProfileManifest & before, const ProfileManifest & after, ProfileManifest & current)
+{
+    bool changed = false;
+    for (auto & [name, made] : after.elements) {
+        auto was = before.elements.find(name);
+        if (was != before.elements.end() && sameElement(was->second, made))
+            continue;
+        auto now = current.elements.find(name);
+        if (now == current.elements.end() || !sameElement(now->second, made))
+            continue;
+        if (was != before.elements.end())
+            now->second = was->second;
+        else
+            current.elements.erase(now);
+        changed = true;
+    }
+    for (auto & [name, was] : before.elements)
+        if (!after.elements.contains(name) && current.elements.emplace(name, was).second)
+            changed = true;
+    return changed;
+}
+
+/**
+ * Where `nix profile` records packages (setting `profile-backend`).
+ */
+struct ProfileBackend
+{
+    virtual ~ProfileBackend() = default;
+
+    /** As in `NIX_PROFILE_BACKEND`. */
+    virtual std::string_view kind() const = 0;
+
+    /** Whether this backend records `element`; the next backend in the chain gets the others. */
+    virtual bool accepts(const ProfileElement & element) const = 0;
+
+    virtual ProfileManifest load(EvalState & state) = 0;
+
+    /** Checks that a change can be committed, before anything is built. Takes no lock. */
+    virtual void prepare() {}
+
+    /** Takes the lock a commit holds through its hook, if the backend has one. Lock order: ADR 0007. */
+    virtual void lockForCommit() {}
+
+    /** Under the backend's lock, applies `deltas` to the current state (left in `manifest`) and records the
+        result if they changed it, then runs `profile-hook`; reverts if it fails. Returns how to undo the
+        change when a later backend of the same command fails. */
+    virtual std::function<void()> commit(
+        ref<Store> store,
+        EvalState & state,
+        const std::vector<Delta> & deltas,
+        std::string_view operation,
+        ProfileManifest & manifest) = 0;
+
+    /** The profile whose generations are this backend's versions. */
+    virtual std::filesystem::path generations() const = 0;
+
+    virtual ProfileManifest loadGeneration(EvalState & state, const std::filesystem::path & generation) = 0;
+
+    virtual void rollback(ref<Store> store, std::optional<GenerationNumber> version, bool dryRun) = 0;
+};
+
+static LocalFSStore & requireLocalFSStore(Store & store)
+{
+    auto * local = dynamic_cast<LocalFSStore *>(&store);
+    if (!local)
+        throw Error("'nix profile' is not supported for this Nix store");
+    return *local;
+}
+
+/** Stock `nix profile`: a profile's generations. */
+struct ProfileProfileBackend : ProfileBackend
+{
+    std::filesystem::path profile;
+
+    ProfileProfileBackend(std::filesystem::path profile)
+        : profile(std::move(profile))
+    {
+    }
+
+    std::string_view kind() const override
+    {
+        return "profile";
+    }
+
+    bool accepts(const ProfileElement & element) const override
+    {
+        return true;
+    }
+
+    ProfileManifest load(EvalState & state) override
+    {
+        return ProfileManifest(state, profile);
+    }
+
+    void install(ref<Store> store, ProfileManifest & manifest)
+    {
+        switchLink(profile, createGeneration(requireLocalFSStore(*store), profile, manifest.build(store)));
+    }
+
+    std::function<void()> commit(
+        ref<Store> store,
+        EvalState & state,
+        const std::vector<Delta> & deltas,
+        std::string_view operation,
+        ProfileManifest & manifest) override
+    {
+        PathLocks lock;
+        lockProfile(lock, profile);
+        manifest = load(state);
+        auto before = manifest;
+        if (!applyDeltas(deltas, manifest))
+            return []() {};
+        install(store, manifest);
+        // Before the hook: an activation inside it changes this profile. Others can commit from here on,
+        // so a revert is a commit of its own, not a step back to the previous generation.
+        lock.unlock();
+        auto revert = [this, store, &state, before, after = manifest]() {
+            PathLocks lock;
+            lockProfile(lock, profile);
+            auto current = load(state);
+            if (undoCommit(before, after, current))
+                install(store, current);
+        };
+        runProfileHookOrRevert(kind(), profile, std::nullopt, operation, revert);
+        return revert;
+    }
+
+    std::filesystem::path generations() const override
+    {
+        return profile;
+    }
+
+    ProfileManifest loadGeneration(EvalState & state, const std::filesystem::path & generation) override
+    {
+        return ProfileManifest(state, generation);
+    }
+
+    void rollback(ref<Store> store, std::optional<GenerationNumber> version, bool dryRun) override
+    {
+        auto prev = findGenerations(profile).second;
+        switchGeneration(profile, version, dryRun);
+        if (dryRun)
+            return;
+        runProfileHookOrRevert(kind(), profile, std::nullopt, "rollback", [&]() {
+            if (prev)
+                switchGeneration(profile, prev, false);
+        });
+    }
+};
+
+static std::optional<std::string> readFileIfExists(const std::filesystem::path & path)
+{
+    if (!std::filesystem::exists(path))
+        return std::nullopt;
+    return readFile(path);
+}
+
+/* Replaces the file `path` resolves to (a symlink stays one), keeping its mode. */
+static void writeFileAtomic(const std::filesystem::path & path, std::string_view contents)
+{
+    auto target = std::filesystem::weakly_canonical(path);
+    auto tmp = target;
+    tmp += ".nix-profile-tmp";
+    writeFile(tmp, contents, 0666, FsSync::Yes);
+    if (std::filesystem::exists(target))
+        std::filesystem::permissions(tmp, std::filesystem::status(target).permissions());
+    std::filesystem::rename(tmp, target);
+}
+
+/**
+ * A JSON declaration of flake packages that `profile-hook` installs, e.g. by building a
+ * configuration that reads it. Format: `{"version": 1, "elements": {name: element}}`, where an
+ * element has the `manifest.json` fields `originalUrl`, `url`, `attrPath`, `outputs` and `priority`.
+ */
+struct DeclarationProfileBackend : ProfileBackend
+{
+    std::filesystem::path file;
+    /** The default profile, for `NIX_PROFILE`. */
+    std::filesystem::path profile;
+    std::filesystem::path history;
+    PathLocks lock;
+    bool locked = false;
+
+    DeclarationProfileBackend(std::filesystem::path file, std::filesystem::path profile)
+        : file(std::move(file))
+        , profile(std::move(profile))
+        , history(profilesDir(settings.getProfileDirsOptions()) / "declaration")
+    {
+    }
+
+    std::string_view kind() const override
+    {
+        return "declaration";
+    }
+
+    bool accepts(const ProfileElement & element) const override
+    {
+        return element.source.has_value();
+    }
+
+    static ProfileManifest parse(const std::string & contents, const std::filesystem::path & path)
+    {
+        try {
+            auto json = nlohmann::json::parse(contents);
+            if (!json.is_object() || json.value("version", 0) != 1)
+                throw Error("declaration %s has an unsupported version (expected 1)", PathFmt(path));
+            auto & elements = json.at("elements");
+            if (!elements.is_object())
+                throw Error("declaration %s is not valid: 'elements' is not an object", PathFmt(path));
+            ProfileManifest manifest;
+            for (auto & [name, e] : elements.items()) {
+                auto originalRef = parseFlakeRef(fetchSettings, e.at("originalUrl").get<std::string>());
+                ProfileElement element;
+                element.source = ProfileElementSource{
+                    .originalRef = originalRef,
+                    .lockedRef =
+                        e.contains("url") ? parseFlakeRef(fetchSettings, e["url"].get<std::string>()) : originalRef,
+                    .attrPath = e.at("attrPath"),
+                    .outputs = e.value("outputs", nlohmann::json()).get<ExtendedOutputsSpec>(),
+                };
+                element.priority = e.value("priority", defaultPriority);
+                manifest.elements.insert_or_assign(name, std::move(element));
+            }
+            return manifest;
+        } catch (nlohmann::json::exception & e) {
+            throw Error("declaration %s is not valid: %s", PathFmt(path), e.what());
+        }
+    }
+
+    static std::string serialize(const ProfileManifest & manifest)
+    {
+        auto es = nlohmann::json::object();
+        for (auto & [name, element] : manifest.elements) {
+            assert(element.source);
+            es[name] = {
+                {"originalUrl", element.source->originalRef.to_string()},
+                {"url", element.source->lockedRef.to_string()},
+                {"attrPath", element.source->attrPath},
+                {"outputs", element.source->outputs},
+                {"priority", element.priority},
+            };
+        }
+        return nlohmann::json{{"version", 1}, {"elements", es}}.dump(2) + "\n";
+    }
+
+    ProfileManifest load(EvalState & state) override
+    {
+        auto contents = readFileIfExists(file);
+        return contents ? parse(*contents, file) : ProfileManifest();
+    }
+
+    StorePath storePathOf(Store & store, const std::string & contents)
+    {
+        return store.makeFixedOutputPathFromCA(
+            file.filename().string(),
+            TextInfo{.hash = hashString(HashAlgorithm::SHA256, contents), .references = {}});
+    }
+
+    /* Whether `contents` is the current version (comparing store paths: an old generation may dangle). */
+    bool isCurrent(Store & store, const std::string & contents)
+    {
+        auto [gens, cur] = findGenerations(history);
+        auto path = store.printStorePath(storePathOf(store, contents));
+        for (auto & gen : gens)
+            if (cur && gen.number == *cur)
+                return readLink(gen.path).string() == path && std::filesystem::exists(gen.path);
+        return false;
+    }
+
+    /* Keeps `contents` as the newest version unless it already is. */
+    void record(ref<Store> store, const std::string & contents)
+    {
+        if (isCurrent(*store, contents))
+            return;
+        StringSource source{contents};
+        auto path = store->addToStoreFromDump(
+            source,
+            file.filename().string(),
+            FileSerialisationMethod::Flat,
+            ContentAddressMethod::Raw::Text,
+            HashAlgorithm::SHA256);
+        switchLink(history, createGeneration(requireLocalFSStore(*store), history, path));
+    }
+
+    void lockForCommit() override
+    {
+        if (locked)
+            return;
+        lockProfile(lock, history);
+        locked = true;
+    }
+
+    void prepare() override
+    {
+        if (!profileHook())
+            throw Error(
+                "the declaration backend needs 'profile-hook' to install what %s declares", PathFmt(file));
+        if (!std::filesystem::exists(file))
+            throw Error(
+                "declaration %s does not exist; create it with {\"version\": 1, \"elements\": {}}, "
+                "or use '--profile-backend profile'",
+                PathFmt(file));
+    }
+
+    /* Writes `contents` and runs the hook; puts `previous` back if the hook fails. The lock is held
+       throughout, so `previous` is still the state to return to. */
+    void apply(ref<Store> store, const std::string & previous, const std::string & contents, std::string_view operation)
+    {
+        // Hand edits since the last change become a version of their own.
+        record(store, previous);
+        writeFileAtomic(file, contents);
+        runProfileHookOrRevert(kind(), profile, file, operation, [&]() { writeFileAtomic(file, previous); });
+    }
+
+    std::function<void()> commit(
+        ref<Store> store,
+        EvalState & state,
+        const std::vector<Delta> & deltas,
+        std::string_view operation,
+        ProfileManifest & manifest) override
+    {
+        lockForCommit();
+        prepare();
+        auto previous = readFile(file);
+        manifest = parse(previous, file);
+        bool changed = applyDeltas(deltas, manifest);
+        auto contents = serialize(manifest);
+        // Equal contents: e.g. an upgrade that re-locked to the same source, nothing to apply.
+        if (!changed || contents == previous)
+            return []() {};
+        apply(store, previous, contents, operation);
+        record(store, contents);
+        // commitBackends commits this backend last, so nothing can fail after it.
+        return []() {};
+    }
+
+    std::filesystem::path generations() const override
+    {
+        return history;
+    }
+
+    ProfileManifest loadGeneration(EvalState & state, const std::filesystem::path & generation) override
+    {
+        return parse(readFile(generation), generation);
+    }
+
+    void rollback(ref<Store> store, std::optional<GenerationNumber> version, bool dryRun) override
+    {
+        lockForCommit();
+        prepare();
+        auto previous = readFile(file);
+        auto [gens, cur] = findGenerations(history);
+        // After a hand edit, the previous version is the current generation itself.
+        bool edited = !isCurrent(*store, previous);
+        std::optional<Generation> target;
+        for (auto & gen : gens)
+            if (version ? gen.number == *version : (cur && (edited ? gen.number <= *cur : gen.number < *cur)))
+                target = gen;
+        if (!target)
+            throw Error(
+                version ? fmt("declaration version %d does not exist", *version)
+                        : std::string("no earlier declaration version to roll back to"));
+        if (!std::filesystem::exists(target->path))
+            throw Error(
+                "declaration version %d is no longer in the store (%s)",
+                target->number,
+                readLink(target->path).string());
+        if (dryRun) {
+            notice("would roll back %s to version %d", PathFmt(file), target->number);
+            return;
+        }
+        notice("rolling back %s to version %d", PathFmt(file), target->number);
+        apply(store, previous, readFile(target->path), "rollback");
+        // As for a profile, a rollback moves the current version back instead of adding one.
+        // (switchLink: switchGeneration would wait for the lock held here.)
+        switchLink(history, target->path);
+    }
+};
+
+static std::vector<ref<ProfileBackend>> getProfileBackends(const MixProfile & cmd)
+{
+    auto defaultProfile = getDefaultProfile(settings.getProfileDirsOptions());
+    auto & spec = profileSettings.backend.get();
+
+    if (cmd.profile && absPath(*cmd.profile) != absPath(defaultProfile)) {
+        if (profileSettings.backend.fromCommandLine)
+            throw UsageError(
+                "'--profile' and '--profile-backend' cannot be used together ('--profile <path>' is short for "
+                "'--profile-backend profile:<path>')");
+        return {make_ref<ProfileProfileBackend>(absPath(*cmd.profile))};
+    }
+
+    auto target = [&](std::string_view prefix) -> std::optional<std::filesystem::path> {
+        if (!hasPrefix(spec, prefix))
+            return std::nullopt;
+        std::filesystem::path path = spec.substr(prefix.size());
+        if (!path.is_absolute())
+            throw UsageError("'profile-backend = %s' needs an absolute path after '%s'", spec, prefix);
+        return path;
+    };
+
+    if (spec == "profile")
+        return {make_ref<ProfileProfileBackend>(defaultProfile)};
+    if (auto path = target("profile:"))
+        return {make_ref<ProfileProfileBackend>(*path)};
+    if (auto path = target("declaration:"))
+        return {
+            make_ref<DeclarationProfileBackend>(*path, defaultProfile),
+            make_ref<ProfileProfileBackend>(defaultProfile)};
+    throw UsageError(
+        "invalid 'profile-backend' value '%s': expected 'profile', 'profile:<path>' or 'declaration:<path>'", spec);
+}
+
+static std::vector<ProfileManifest> loadManifests(EvalState & state, const std::vector<ref<ProfileBackend>> & backends)
+{
+    std::vector<ProfileManifest> manifests;
+    for (auto & backend : backends)
+        manifests.push_back(backend->load(state));
+    return manifests;
+}
+
+/* Commits the backends with deltas, the profile first (a declaration's hook may change the profile
+   itself); if one fails, the ones already committed are reverted too. A command that changes the
+   declaration holds its lock from the start, so its profile commit and any undo run inside it. */
+static void commitBackends(
+    const std::vector<ref<ProfileBackend>> & backends,
+    const std::vector<std::vector<Delta>> & deltas,
+    std::function<std::function<void()>(size_t)> commitOne)
+{
+    if (!deltas[0].empty())
+        backends[0]->lockForCommit();
+    std::vector<std::function<void()>> undo;
+    try {
+        for (size_t b = backends.size(); b-- > 0;)
+            if (!deltas[b].empty())
+                undo.push_back(commitOne(b));
+    } catch (...) {
+        for (auto i = undo.rbegin(); i != undo.rend(); ++i) {
+            try {
+                (*i)();
+            } catch (...) {
+                ignoreExceptionExceptInterrupt();
+            }
+        }
+        throw;
+    }
+}
