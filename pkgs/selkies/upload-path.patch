Selkies: a separate upload directory (upload_path / SELKIES_UPLOAD_PATH)

Against Selkies 2.1.0. Applied by pkgs/selkies.nix; written for upstream,
see docs/upstream/selkies-upload-path.md.
Uploads (HTTP /api/upload, the websockets and WebRTC data-channel paths) go to upload_path when it
is set, else to file_manager_path as before. Downloads and the file browser keep file_manager_path.
-----

--- a/src/selkies/settings.py
+++ b/src/selkies/settings.py
@@ -831,6 +831,13 @@
         "help": "Directory for client file transfers on both transports: uploads land here and the file-browser/download API serves it (created at startup if missing).",
     },
     {
+        "name": "upload_path",
+        "type": "str",
+        "default": "",
+        "env_var": "UPLOAD_PATH",
+        "help": "Directory client uploads land in on both transports; downloads keep being served from file_manager_path. Empty uploads into file_manager_path (created at startup if missing).",
+    },
+    {
         "name": "watermark_path",
         "type": "str",
         "default": "",
@@ -2255,7 +2262,7 @@
