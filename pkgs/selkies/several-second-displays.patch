+# Where app screens start, right of any primary a browser page auto-sizes (the web client caps it
+# at 4080) so a primary resize moves none of them. Moving an output recreates it.
+SECONDARY_ROW_START = 4096
+
+
+def place_secondaries(primary_w, sizes, previous):
+    """The x of each secondary (id -> (w, h)) in a row right of the primary. A display stays where
+    it is in `previous` unless the one before it now reaches past that, so closing or resizing one
+    leaves the others alone; a new one takes the first gap it fits."""
+    start = max(primary_w, SECONDARY_ROW_START)
+    placed = {}
+    edge = start
+    kept = [d for d in sizes if d in previous]
+    for did in sorted(kept, key=lambda d: previous[d]['x']):
+        placed[did] = max(previous[did]['x'], edge)
+        edge = placed[did] + sizes[did][0]
+    for did in sorted(set(sizes) - set(kept), key=wayland_output_id):
+        x = start
+        for other in sorted(placed, key=placed.get):
+            if x + sizes[did][0] <= placed[other]:
+                break
+            x = max(x, placed[other] + sizes[other][0])
+        placed[did] = x
+    return placed
+
