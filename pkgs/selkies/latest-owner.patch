+    def _demote_primary_owner(self, owner_ws: Any, owner: dict) -> None:
+        """Move the primary's live owner beside the page taking the display. It
+        keeps its socket, the audio it hears and any pause; without its
+        `_page_settings`, its SETTINGS on promotion counts as a first one."""
+        self._beside_audio[owner_ws] = self._hears_audio(owner_ws)
+        self.co_controllers.setdefault('primary', OrderedDict())[owner_ws] = owner.get('tab_id')
