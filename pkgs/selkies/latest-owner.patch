+    def _joins_beside_owner(self, websocket: Any, tab_id: Optional[str],
+                            opens_page: bool) -> bool:
+        """Whether a controller's SETTINGS for the primary makes it a controller
+        beside the display's owner rather than its owner: one already beside it,
+        or one of another tab, unless it holds full permissions and `opens_page`
+        (the socket's first SETTINGS, not the web client reconnecting in place).
+        """
+        if websocket in self.co_controllers.get('primary', ()):
+            return True
+        return (self._owner_is_another_tab(websocket, tab_id)
+                and not (opens_page and self._holds_full_control(websocket)))
